{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "board:realtime": "REALTIME_PORT=3001 INTERNAL_APP_ORIGIN=http://127.0.0.1:3000 node --env-file-if-exists=.env --env-file-if-exists=.env.local realtime/server.mjs",
    "board:load": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/load-test-boards.mjs",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "test": "npm run build && node --test tests/vps-release.test.mjs tests/board-*.test.mjs",
    "test:sites": "npm run build:sites && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "variants:import": "node scripts/import-exam-variant.mjs",
    "variants:import-all": "node scripts/import-kompege-variants.mjs",
    "variants:sync-tasks": "node scripts/sync-variant-tasks.mjs",
    "kege:sync": "node scripts/sync-kompege.mjs",
    "files:rewrite-links": "node scripts/rewrite-kompege-file-links.mjs",
    "tasks:import": "node scripts/import-kompege-tasks.mjs",
    "tasks:render-math": "node scripts/render-task-math.mjs",
    "tasks:split": "node scripts/split-task-data.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "next": "^16.3.1",
    "perfect-freehand": "^1.2.3",
    "prismjs": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
