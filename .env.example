# Public address of the VPS deployment, without a trailing slash.
DOMAIN=example.ru
SITE_URL=https://example.ru
NEXT_PUBLIC_SITE_URL=https://example.ru

# Yandex ID OAuth application. Keep the secret only on the server.
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret

# Google OAuth 2.0 Web application. Authorized redirect URI:
# https://example.ru/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Random secret with at least 32 characters for signed board realtime sessions.
BOARD_SESSION_SECRET=replace-with-a-long-random-secret

# Only these accounts receive administrator access.
ADMIN_EMAILS=egortsarapkinpersona@gmail.com

# Persistent VPS data. Mount this directory into the container.
DATA_DIR=/app/data
SQLITE_PATH=/app/data/egege.sqlite
